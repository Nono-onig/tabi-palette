<%
  # 英語が登録されていれば英語を表示する
  # 未登録の場合は日本語を表示する
  field = ->(jp, en) {
    @english && en.present? ? en : jp
  }

  country_name = field.call(@country.country, @country.country_en)
  country_image = country_image_path(@country.country)

  info_cards = [
    { icon: "💰", key: "price",        jp: "費用",             en: "Costs",                 text: field.call(@country.price, @country.price_en), tone: "orange" },
    { icon: "🛂", key: "visa",         jp: "ビザ・入国について", en: "Visa & Entry",          text: field.call(@country.visa_timing, @country.visa_timing_en), tone: "sky" },
    { icon: "🧳", key: "preparation",  jp: "渡航前の準備",      en: "Before You Travel",     text: field.call(@country.preparation, @country.preparation_en), tone: "sky" },
    { icon: "🎒", key: "items",        jp: "あると便利なもの",   en: "Useful Items",          text: field.call(@country.useful_items, @country.useful_items_en), tone: "orange" },
    { icon: "🚃", key: "transport",    jp: "現地の交通",        en: "Transportation",        text: field.call(@country.transportation, @country.transportation_en), tone: "sky", wide: true },
    { icon: "⚠️", key: "cautions",     jp: "注意点",            en: "Tips & Warnings",       text: field.call(@country.cautions, @country.cautions_en), tone: "warn", wide: true }
  ].select { |c| c[:text].present? }
%>
<% content_for :title, country_name %>

<div class="country-page">

  <%# 国名・メイン写真 %>
  <section class="country-hero"<% if country_image %> style="background-image: url('<%= country_image %>');"<% end %>>
    <div class="container country-hero-inner">
      <div class="country-lang" role="group" aria-label="<%= @english ? 'Language' : '言語' %>">
        <%= link_to "日本語", country_path(@country), class: "country-lang-link#{' is-active' unless @english}", "aria-current": (@english ? nil : "page") %>
        <%= link_to "English", country_path(@country, locale: "en"), class: "country-lang-link#{' is-active' if @english}", "aria-current": (@english ? "page" : nil) %>
      </div>

      <div class="country-hero-copy">
        <p class="eyebrow country-eyebrow">Travel Guide</p>
        <h1 class="country-title"><%= country_name %></h1>
        <p class="country-hero-text">
          <%= @english ? "Everything to know before your trip" : "旅に出る前に知っておきたいこと" %>
        </p>
      </div>
    </div>
  </section>

  <div class="container country-body">

    <%# 目次 %>
    <nav class="country-toc" aria-label="<%= @english ? 'Contents' : '目次' %>">
      <a href="#about">🌏 <%= @english ? "About" : "この国について" %></a>
      <% info_cards.each do |c| %>
        <a href="#<%= c[:key] %>"><%= c[:icon] %> <%= @english ? c[:en] : c[:jp] %></a>
      <% end %>
    </nav>

    <%# この国について %>
    <% if field.call(@country.description, @country.description_en).present? %>
      <section class="country-about card card-pad" id="about">
        <h2 class="country-section-title">
          <span class="country-icon" aria-hidden="true">🌏</span>
          <%= @english ? "About this country" : "この国について" %>
        </h2>
        <div class="country-text">
          <%= simple_format(field.call(@country.description, @country.description_en)) %>
        </div>
      </section>
    <% end %>

    <%# 費用・ビザ・準備・持ち物・交通・注意点 %>
    <div class="country-grid">
      <% info_cards.each do |c| %>
        <section class="country-card country-card-<%= c[:tone] %><%= ' is-wide' if c[:wide] %>" id="<%= c[:key] %>">
          <h2 class="country-card-title">
            <span class="country-icon" aria-hidden="true"><%= c[:icon] %></span>
            <%= @english ? c[:en] : c[:jp] %>
          </h2>
          <div class="country-text">
            <%= simple_format(c[:text]) %>
          </div>
        </section>
      <% end %>
    </div>

    <%# 参考リンク %>
    <% if @country.link.present? %>
      <section class="country-link card card-pad">
        <div>
          <p class="eyebrow">Official information</p>
          <h2 class="country-section-title"><%= @english ? "Official Links" : "参考リンク" %></h2>
          <p class="country-link-text">
            <%= @english ? "For official information about visas and entry requirements, please visit the website." : "ビザ・入国の最新情報は、各国の公式サイトで必ず確認してください。" %>
          </p>
        </div>
        <%= link_to(@country.link, target: "_blank", rel: "noopener", class: "btn btn-primary") do %>
          <%= @english ? "Official website" : "公式サイトを見る" %> <span aria-hidden="true">↗</span>
        <% end %>
      </section>
    <% end %>

    <%# この国の投稿 %>
    <% if @tweets.any? %>
      <section class="country-posts">
        <h2 class="section-title"><%= @english ? "Travel posts" : "この国の旅の投稿" %></h2>
        <div class="post-grid">
          <%= render partial: "tweets/post_card", collection: @tweets.first(4), as: :tweet %>
        </div>
      </section>
    <% end %>

    <%# 戻るボタン %>
    <div class="btn-row center back-area">
      <%= link_to(@english ? "← Back" : "← 診断結果に戻る", :back, class: "btn btn-outline") %>
      <%= link_to(@english ? "Take the quiz again" : "もう一度診断する", new_test_path, class: "btn btn-ghost") %>
    </div>
  </div>
</div>
