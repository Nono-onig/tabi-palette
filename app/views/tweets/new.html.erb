<% content_for :title, "旅の思い出を投稿" %>
<div class="post-form-page page">
  <div class="container-narrow">

    <div class="page-head">
      <p class="eyebrow">New Post</p>
      <h1 class="page-title">旅の思い出を投稿しよう</h1>
      <p class="page-lead">あなたのお気に入りの旅を、みんなにシェアしよう。</p>
    </div>

    <div class="card card-pad">
      <%= form_for @tweet, html: { multipart: true, class: "form-stack" } do |f| %>

        <div class="form-grid-2">
          <div class="field">
            <%= f.label :region, "🗺️ 地域" %>
            <%= f.select :region,
              [
                ["アジア", "アジア"],
                ["ヨーロッパ", "ヨーロッパ"],
                ["オセアニア", "オセアニア"],
                ["北アメリカ", "北アメリカ"],
                ["南アメリカ", "南アメリカ"],
                ["アフリカ", "アフリカ"]
              ],
              { include_blank: "地域をえらんでね" },
              class: "select" %>
          </div>

          <div class="field">
            <%= f.label :place, "⛰️ 国名" %>
            <%= f.text_field :place, class: "input", placeholder: "例：タイ" %>
          </div>
        </div>

        <div class="field">
          <%= f.label :location, "🚃 場所の名前" %>
          <%= f.text_field :location, class: "input", placeholder: "例：ワット・アルン" %>
        </div>

        <div class="field">
          <%= f.label :cost, "💰 コスト" %>
          <%= f.text_area :cost, class: "textarea textarea-sm", placeholder: "例：入場料 200バーツくらい" %>
        </div>

        <div class="field">
          <%= f.label :image, "📷 写真" %>
          <div class="file-drop">
            <p>お気に入りの旅の写真を選んでね</p>
            <%= f.file_field :image, accept: "image/*" %>
          </div>
        </div>

        <div class="field">
          <%= f.label :picture, "📸 どんな写真？" %>
          <%= f.text_field :picture, class: "input", placeholder: "例：夕暮れのワット・アルン" %>
        </div>

        <div class="field">
          <%= f.label :comment, "💬 コメント" %>
          <%= f.text_area :comment, class: "textarea", placeholder: "旅の思い出やおすすめポイントを書いてみよう..." %>
        </div>

        <div class="field">
          <%= f.label :recommendation, "💡 こんな人におすすめ" %>
          <%= f.text_area :recommendation, class: "textarea textarea-sm", placeholder: "例：歴史が好きな人、写真を撮るのが好きな人" %>
        </div>

        <fieldset class="field">
          <legend class="field-label">🏷️ タグを選ぼう</legend>
          <div class="chip-group">
            <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |tag| %>
              <label class="chip">
                <%= tag.check_box %>
                <%= tag.text %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="form-submit">
          <%= f.submit "投稿する ✈︎", class: "btn btn-accent btn-lg btn-block" %>
        </div>
      <% end %>
    </div>

    <!-- 新しいタグ -->
    <section class="add-tag card card-pad">
      <h2 class="add-tag-title">＋ 新しいタグを追加</h2>
      <p class="add-tag-lead">使いたいタグがなければ、自分で追加できます。<br>※ 追加すると入力中の内容はリセットされます。先にタグを追加してから投稿を書くのがおすすめです。</p>

      <%= form_tag "/tweets/add_tag", method: :post, class: "add-tag-form" do %>
        <label for="new_tag" class="visually-hidden">新しいタグ名</label>
        <%= text_field_tag :new_tag, nil, class: "input", placeholder: "例：☕ カフェ巡り" %>
        <%= submit_tag "タグを追加", class: "btn btn-outline" %>
      <% end %>
    </section>

    <div class="back-area">
      <%= link_to "← トップに戻る", root_path, class: "btn btn-ghost" %>
    </div>
  </div>
</div>
