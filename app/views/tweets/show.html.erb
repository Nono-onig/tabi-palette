<% content_for :title, @tweet.place.presence || "旅の思い出" %>
<div class="tweet-show-page page">
  <div class="container tweet-show-container">

    <nav class="breadcrumb" aria-label="パンくずリスト">
      <%= link_to "トップ", root_path %>
      <span aria-hidden="true">/</span>
      <%= link_to "みんなの投稿", all_posts_tweets_path %>
      <span aria-hidden="true">/</span>
      <span aria-current="page"><%= @tweet.place %></span>
    </nav>

    <article class="tweet-show">
      <!-- 写真 -->
      <figure class="tweet-show-media">
        <% if @tweet.image.attached? %>
          <%= image_tag @tweet.image, alt: @tweet.picture.presence || "#{@tweet.place}の写真" %>
        <% else %>
          <div class="tweet-show-noimage" aria-hidden="true">✈︎</div>
        <% end %>
        <% if @tweet.picture.present? %>
          <figcaption>📷 <%= @tweet.picture %></figcaption>
        <% end %>
      </figure>

      <!-- 本文 -->
      <div class="tweet-show-body">
        <header class="tweet-show-head">
          <p class="eyebrow">Travel Memory</p>
          <h1 class="tweet-show-title"><%= @tweet.place %></h1>
          <% if @tweet.location.present? %>
            <p class="tweet-show-location">📍 <%= @tweet.location %></p>
          <% end %>

          <p class="tweet-show-meta">
            <% if @tweet.user %>
              <% if user_signed_in? %>
                <%= link_to "#{@tweet.user.name} さん", user_path(@tweet.user), class: "text-link" %>
              <% else %>
                <%= @tweet.user.name %> さん
              <% end %>
              ・
            <% end %>
            <time datetime="<%= @tweet.created_at.iso8601 %>"><%= @tweet.created_at.strftime("%Y年%-m月%-d日") %></time>
          </p>
        </header>

        <dl class="tweet-show-facts">
          <% if @tweet.region.present? %>
            <div><dt>🗺️ 地域</dt><dd><%= @tweet.region %></dd></div>
          <% end %>
          <% if @tweet.place.present? %>
            <div><dt>⛰️ 国名</dt><dd><%= @tweet.place %></dd></div>
          <% end %>
          <% if @tweet.location.present? %>
            <div><dt>🚃 場所</dt><dd><%= @tweet.location %></dd></div>
          <% end %>
          <% if @tweet.cost.present? %>
            <div><dt>💰 コスト</dt><dd><%= @tweet.cost %></dd></div>
          <% end %>
        </dl>

        <% if @tweet.tags.any? %>
          <div class="tag-list tweet-show-tags">
            <% @tweet.tags.each do |tag| %>
              <span class="tag"><%= tag.name %></span>
            <% end %>
          </div>
        <% end %>

        <% if user_signed_in? && @tweet.user == current_user %>
          <div class="btn-row tweet-owner-actions">
            <%= link_to "編集する ✎", edit_tweet_path(@tweet), class: "btn btn-outline btn-sm" %>
            <%= button_to "削除する",
              tweet_path(@tweet),
              method: :delete,
              form: { data: { turbo_confirm: "この投稿を削除しますか？" } },
              class: "btn btn-danger btn-sm" %>
          </div>
        <% end %>
      </div>
    </article>

    <div class="tweet-show-texts">
      <% if @tweet.comment.present? %>
        <section class="tweet-show-text card card-pad">
          <h2>💬 旅の思い出</h2>
          <%= simple_format(@tweet.comment) %>
        </section>
      <% end %>

      <% if @tweet.recommendation.present? %>
        <section class="tweet-show-text tweet-show-reco card card-pad">
          <h2>💡 こんな人におすすめ</h2>
          <%= simple_format(@tweet.recommendation) %>
        </section>
      <% end %>
    </div>

    <div class="back-area">
      <%= link_to "← 投稿一覧に戻る", all_posts_tweets_path, class: "btn btn-outline" %>
    </div>
  </div>
</div>
