<% content_for :title, "投稿を編集" %>
<div class="post-form-page page">
  <div class="container-narrow">

    <div class="page-head">
      <p class="eyebrow">Edit Post</p>
      <h1 class="page-title">投稿を編集する</h1>
      <p class="page-lead">旅の思い出を更新しよう。</p>
    </div>

    <div class="card card-pad">
      <%= form_for @tweet, html: { multipart: true, class: "form-stack" } do |f| %>

        <% if @tweet.errors.any? %>
          <div class="form-errors">
            <ul>
              <% @tweet.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-grid-2">
          <div class="field">
            <%= f.label :region, "🗺️ 地域" %>
            <%= f.select :region,
              [
                ["アジア", "アジア"],
                ["ヨーロッパ", "ヨーロッパ"],
                ["オセアニア", "オセアニア"],
                ["北アメリカ", "北アメリカ"],
                ["南アメリカ", "南アメリカ"],
                ["アフリカ", "アフリカ"]
              ],
              { include_blank: "地域をえらんでね" },
              class: "select" %>
          </div>

          <div class="field">
            <%= f.label :place, "⛰️ 国名" %>
            <%= f.text_field :place, class: "input", placeholder: "例：タイ" %>
          </div>
        </div>

        <div class="field">
          <%= f.label :location, "🚃 場所の名前" %>
          <%= f.text_field :location, class: "input", placeholder: "例：ワット・アルン" %>
        </div>

        <div class="field">
          <%= f.label :cost, "💰 コスト" %>
          <%= f.text_area :cost, class: "textarea textarea-sm", placeholder: "例：入場料 200バーツ" %>
        </div>

        <% if @tweet.image.attached? %>
          <div class="field">
            <p class="field-label">📷 現在の写真</p>
            <div class="current-image">
              <%= image_tag @tweet.image, alt: "現在の写真" %>
            </div>
            <label class="checkbox-row">
              <%= check_box_tag :remove_image, "1" %>
              この写真を削除する
            </label>
          </div>
        <% end %>

        <div class="field">
          <%= f.label :image, "📸 写真を変更する" %>
          <div class="file-drop">
            <p>新しい写真を選ぶと写真を変更できます</p>
            <%= f.file_field :image, accept: "image/*" %>
          </div>
        </div>

        <div class="field">
          <%= f.label :picture, "🖼️ どんな写真？" %>
          <%= f.text_field :picture, class: "input", placeholder: "例：夕暮れのワット・アルン" %>
        </div>

        <div class="field">
          <%= f.label :comment, "💬 コメント" %>
          <%= f.text_area :comment, class: "textarea", placeholder: "旅の思い出を書いてみよう..." %>
        </div>

        <div class="field">
          <%= f.label :recommendation, "💡 こんな人におすすめ" %>
          <%= f.text_area :recommendation, class: "textarea textarea-sm", placeholder: "例：歴史好きな人、写真好きな人" %>
        </div>

        <fieldset class="field">
          <legend class="field-label">🏷️ タグ</legend>
          <div class="chip-group">
            <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |tag| %>
              <label class="chip">
                <%= tag.check_box %>
                <%= tag.text %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="form-submit btn-row">
          <%= f.submit "更新する ✈︎", class: "btn btn-accent btn-lg" %>
          <%= link_to "キャンセル", tweet_path(@tweet), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>

    <div class="back-area">
      <%= link_to "← 投稿詳細に戻る", tweet_path(@tweet), class: "btn btn-ghost" %>
    </div>
  </div>
</div>
