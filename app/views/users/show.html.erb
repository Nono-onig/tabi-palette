<% content_for :title, "#{@user.name} さんのマイページ" %>
<% own_page = user_signed_in? && current_user.id == @user.id %>

<div class="mypage page">
  <div class="container">

    <!-- プロフィール -->
    <section class="profile">
      <div class="profile-cover" aria-hidden="true"></div>

      <div class="profile-main">
        <div class="profile-avatar" aria-hidden="true"><%= @user.name.to_s.first.presence || "✈︎" %></div>

        <div class="profile-info">
          <p class="eyebrow"><%= own_page ? "My Page" : "Traveler" %></p>
          <h1 class="profile-name"><%= @user.name %> さん</h1>
          <% if own_page %>
            <p class="profile-email">✉️ <%= @user.email %></p>
          <% end %>
          <p class="profile-bio">
            <% if @user.profile.present? %>
              <%= @user.profile %>
            <% else %>
              <span class="profile-empty">まだプロフィールがありません</span>
            <% end %>
          </p>
        </div>

        <div class="profile-side">
          <div class="profile-stat">
            <strong><%= @tweets.size %></strong>
            <span>投稿</span>
          </div>
          <% if own_page %>
            <%= link_to "プロフィールを編集 ✎", edit_user_registration_path, class: "btn btn-outline btn-sm" %>
          <% end %>
        </div>
      </div>
    </section>

    <!-- 投稿一覧 -->
    <section class="mypage-posts">
      <div class="section-head">
        <div>
          <p class="eyebrow">Travel Memories</p>
          <h2 class="section-title"><%= @user.name %> さんの投稿</h2>
        </div>
        <% if own_page %>
          <%= link_to "新しく投稿する ✈︎", new_tweet_path, class: "btn btn-accent btn-sm" %>
        <% end %>
      </div>

      <% if @tweets.present? %>
        <div class="post-grid">
          <%= render partial: "tweets/post_card", collection: @tweets, as: :tweet %>
        </div>
      <% else %>
        <div class="empty-state">
          <p class="empty-state-icon">✈︎</p>
          <p>まだ投稿がありません</p>
          <% if own_page %>
            <%= link_to "旅の思い出を投稿する", new_tweet_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="back-area">
      <%= link_to "← トップページに戻る", root_path, class: "btn btn-ghost" %>
    </div>
  </div>
</div>
