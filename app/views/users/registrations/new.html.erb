<% content_for :title, "新規登録" %>
<div class="auth-page page">
  <div class="container">
    <div class="auth-shell">
      <div class="auth-visual auth-visual-signup" aria-hidden="true">
        <p class="auth-visual-logo">tabi✈︎palette</p>
        <p class="auth-visual-copy">旅のワクワクを、<br>自分らしい色で見つけよう。</p>
      </div>

      <div class="auth-card">
        <p class="eyebrow">Join tabi✈︎palette</p>
        <h1 class="auth-title">新規登録</h1>
        <p class="auth-lead">登録すると、旅の思い出を投稿できるようになります。</p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form-stack" }) do |f| %>
          <%= render "users/shared/error_messages", resource: resource %>

          <div class="field">
            <%= f.label :name, "名前" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "nickname", class: "input", placeholder: "ニックネームでもOK" %>
          </div>

          <div class="field">
            <%= f.label :email, "メールアドレス" %>
            <%= f.email_field :email, autocomplete: "email", class: "input", placeholder: "example@email.com" %>
          </div>

          <div class="field">
            <%= f.label :password, "パスワード" %>
            <% if @minimum_password_length %>
              <p class="field-hint"><%= @minimum_password_length %>文字以上で入力してください</p>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "input", placeholder: "パスワードを入力" %>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, "パスワード（確認）" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input", placeholder: "もう一度入力してください" %>
          </div>

          <%= f.submit "新規登録 ✈︎", class: "btn btn-accent btn-lg btn-block" %>
        <% end %>

        <div class="auth-links">
          <p>すでにアカウントをお持ちの方は <%= link_to "ログインはこちら", new_session_path(resource_name), class: "text-link" %></p>
        </div>
      </div>
    </div>
  </div>
</div>
