<% content_for :title, "プロフィール編集" %>
<div class="auth-page page">
  <div class="container-narrow">

    <div class="page-head">
      <p class="eyebrow">Edit Profile</p>
      <h1 class="page-title">プロフィール編集</h1>
      <p class="page-lead">あなたのプロフィールを更新しよう。</p>
    </div>

    <div class="card card-pad">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "form-stack" }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <div class="field">
          <%= f.label :name, "名前" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input", placeholder: "名前を入力" %>
        </div>

        <div class="field">
          <%= f.label :profile, "プロフィール" %>
          <p class="field-hint">200文字まで</p>
          <%= f.text_area :profile, class: "textarea", maxlength: 200, placeholder: "自己紹介や好きな旅について書いてみよう..." %>
        </div>

        <div class="field">
          <%= f.label :email, "メールアドレス" %>
          <%= f.email_field :email, autocomplete: "email", class: "input", placeholder: "example@email.com" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="form-errors">現在、<strong><%= resource.unconfirmed_email %></strong> の確認待ちです。</p>
        <% end %>

        <div class="auth-divider"><span>パスワードの変更（任意）</span></div>

        <div class="form-grid-2">
          <div class="field">
            <%= f.label :password, "新しいパスワード" %>
            <%= f.password_field :password, autocomplete: "new-password", class: "input", placeholder: "変更しない場合は空欄" %>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input", placeholder: "もう一度入力" %>
          </div>
        </div>
        <% if @minimum_password_length %>
          <p class="field-hint">パスワードは<%= @minimum_password_length %>文字以上で入力してください</p>
        <% end %>

        <div class="auth-divider"><span>確認</span></div>

        <div class="field">
          <%= f.label :current_password, "現在のパスワード" %>
          <p class="field-hint">変更内容を保存するために、現在のパスワードを入力してください</p>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input", placeholder: "現在のパスワード" %>
        </div>

        <div class="btn-row">
          <%= f.submit "更新する ✈︎", class: "btn btn-primary btn-lg" %>
          <%= link_to "キャンセル", user_path(current_user), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>

    <section class="danger-zone card card-pad">
      <div>
        <h2>アカウントを削除する</h2>
        <p>アカウントを削除すると、投稿も含めて元に戻すことはできません。</p>
      </div>
      <%= button_to "アカウントを削除",
        registration_path(resource_name),
        method: :delete,
        form: { data: { turbo_confirm: "本当にアカウントを削除しますか？" } },
        class: "btn btn-danger" %>
    </section>

    <div class="back-area">
      <%= link_to "← マイページに戻る", user_path(current_user), class: "btn btn-ghost" %>
    </div>
  </div>
</div>
