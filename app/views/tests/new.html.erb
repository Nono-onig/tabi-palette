<% content_for :title, "旅先診断" %>
<%
  # 質問と選択肢（value は診断ロジックで使う Palette タイプ。カンマ区切りで複数加点）
  questions = [
    {
      title: "旅行で一番心が動く瞬間は？",
      choices: [
        ["culture",   "何百年も前の建物や遺跡を目の前にしたとき"],
        ["nature",    "見たことのない大自然や絶景に出会ったとき"],
        ["adventure", "初めての場所で、ちょっとドキドキする体験をするとき"],
        ["relax",     "何も考えずぼーっときれいな景色を眺めているとき"],
        ["local",     "現地の人しか知らない料理や日常に触れたとき"],
        ["city",      "おしゃれな街や話題のスポットを歩いているとき"],
        ["art",       "心に残る街並みやアート作品に出会ったとき"]
      ]
    },
    {
      title: "朝から夜まで自由に使える1日。どう過ごす？",
      choices: [
        ["culture",          "街を散策してSNSでは取り上げられていない魅力を見つける"],
        ["nature,adventure", "自然の中でスリル満点なアクティビティをする"],
        ["city,local",       "気になったカフェやお店をできるだけたくさん巡る"],
        ["relax",            "ホテルやビーチでのんびりする"],
        ["art",              "美術館や博物館をじっくり見てまわる"]
      ]
    },
    {
      title: "旅行中、道に迷ってしまった！あなたなら？",
      choices: [
        ["culture,city",         "地図アプリで自分で調べる"],
        ["nature,adventure,art", "せっかくだから街の雰囲気を楽しみながら周辺を歩いてみる"],
        ["relax",                "一旦落ち着ける場所で休む"],
        ["local",                "現地の人にとにかく話しかけて道を教えてもらう"]
      ]
    },
    {
      title: "あなたのお腹は、どちらかというと強い方？",
      choices: [
        ["adventure,local",      "かなり強い！気にせず何でも食べられる"],
        ["city,art",             "普通。衛生面には少し気をつけたい"],
        ["culture,nature,relax", "あまり強くない。旅行中は特に食事に気をつけたい"]
      ]
    },
    {
      title: "あなたが1番“自分らしく楽しめそう”なのは？",
      choices: [
        ["culture,city",    "朝から夜まで予定を決めて、たくさん観光する"],
        ["art",             "行きたい場所だけ決めておく"],
        ["adventure,local", "大まかに決めて、現地で臨機応変に予定を変える"],
        ["relax,nature",    "ほぼノープランで、その日の気分で決める"]
      ]
    },
    {
      title: "旅行中、あなたが1番ストレスに感じそうなのは？",
      choices: [
        ["nature",    "人が多すぎる"],
        ["art",       "移動に時間がかかりすぎる"],
        ["city",      "言葉が通じない"],
        ["local",     "お金がかかりすぎる"],
        ["relax",     "予定が詰まり過ぎて休めない"],
        ["culture",   "天候や列車の遅延で予定が急遽変わる"],
        ["adventure", "毎日同じような観光で退屈する"]
      ]
    },
    {
      title: "あなたの“旅のテーマ”は？",
      choices: [
        ["culture,local", "知らない世界を知る旅"],
        ["city",          "美味しいものを探す旅"],
        ["adventure",     "新しい自分に出会う旅"],
        ["relax",         "何もしない贅沢な旅"],
        ["art,nature",    "美しいものや自然に癒される旅"]
      ]
    }
  ]
%>

<div class="quiz-page page">
  <div class="container-narrow">

    <div class="page-head quiz-head">
      <p class="eyebrow">Travel Palette Check</p>
      <h1 class="page-title"><span class="nowrap">あなたの旅の</span><span class="nowrap">Paletteを作ろう</span></h1>
      <p class="page-lead">7つの質問に答えて、あなたにぴったりな旅行先を見つけよう。</p>
    </div>

    <%= form_with model: @test, class: "quiz", data: { controller: "quiz", action: "change->quiz#select" } do |f| %>

      <div class="quiz-progress" aria-hidden="true">
        <div class="quiz-progress-meta">
          <span>質問 <strong data-quiz-target="current">1</strong> / <%= questions.size %></span>
          <span><span data-quiz-target="answered">0</span> 問回答済み</span>
        </div>
        <div class="quiz-progress-track">
          <div class="quiz-progress-bar" data-quiz-target="bar"></div>
        </div>
        <ol class="quiz-dots">
          <% questions.each_index do |i| %>
            <li data-quiz-target="dot"></li>
          <% end %>
        </ol>
      </div>

      <% questions.each_with_index do |q, i| %>
        <% n = i + 1 %>
        <fieldset class="quiz-step card" data-quiz-target="step">
          <legend class="quiz-question">
            <span class="quiz-q-num">Q<%= n %></span>
            <span class="quiz-q-text" tabindex="-1"><%= q[:title] %></span>
          </legend>

          <div class="quiz-choices">
            <% q[:choices].each do |value, label| %>
              <% id = "question#{n}_#{value.tr(',', '_')}" %>
              <label class="quiz-choice" for="<%= id %>">
                <%= f.radio_button "question#{n}", value, id: id %>
                <span class="quiz-choice-mark" aria-hidden="true"></span>
                <span class="quiz-choice-text"><%= label %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <div class="quiz-nav">
        <button type="button" class="btn btn-ghost quiz-prev" data-quiz-target="prev" data-action="quiz#prev" hidden>
          ← 前の質問
        </button>
        <button type="button" class="btn btn-primary quiz-next" data-quiz-target="next" data-action="quiz#next" hidden>
          次の質問へ →
        </button>
        <%= f.submit "診断結果を見る ✈︎", class: "btn btn-accent btn-lg quiz-submit", data: { quiz_target: "submit" } %>
      </div>

      <p class="quiz-note" data-quiz-target="note" hidden>選択肢をひとつ選んでください</p>
    <% end %>

    <div class="back-area">
      <%= link_to "← トップページに戻る", root_path, class: "btn btn-ghost" %>
    </div>
  </div>

  <%= image_tag "art-girl.png", class: "quiz-illust", alt: "" %>
</div>
